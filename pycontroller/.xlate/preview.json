{
  "name": "Sensor Lab",
  "version": "1.0.1",
  "icon": "assets/images/icon.png",
  "native_generation": "expo",
  "ios": {
    "identifier": "com.dyllan.xlate",
    "workspace": "ios/SensorLab.xcworkspace",
    "scheme": "SensorLab",
    "info_plist": "ios/SensorLab/Info.plist",
    "configuration": "Release",
    "portable_pod_checksums": true
  },
  "android": {
    "identifier": "com.dyllan.xlate",
    "directory": "android",
    "module": "app",
    "task": "assembleRelease",
    "apk": "app/build/outputs/apk/release/app-release-unsigned.apk"
  }
}
