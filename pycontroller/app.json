{
  "expo": {
    "name": "xlate",
    "slug": "pycontroller",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "xlate",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dyllan.xlate",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "This app needs access to your microphone to record and visualize audio waveforms.",
        "NSLocalNetworkUsageDescription": "This app needs access to your local network to discover and connect to the mouse controller server on your computer.",
        "NSBluetoothAlwaysUsageDescription": "This app uses Bluetooth to discover the mouse controller server on your computer.",
        "NSBluetoothPeripheralUsageDescription": "This app uses Bluetooth to discover the mouse controller server on your computer.",
        "NSBonjourServices": [
          "_pymouse._tcp",
          "_magneto._tcp",
          "_http._tcp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.dyllan.xlate",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "444b7fec-7303-43c2-8666-5c5cfb415836"
      }
    }
  }
}
